# ─── Server ───────────────────────────────────────────────
SERVER_PORT=8080

# ─── Database ─────────────────────────────────────────────
# SQLite: usar ruta relativa o absoluta al archivo .db
DB_URL=jdbc:sqlite:dispatch.db
DB_DRIVER=org.sqlite.JDBC
DB_USERNAME=
DB_PASSWORD=

# ─── SQL Init ─────────────────────────────────────────────
# always: ejecuta schema.sql en cada arranque (idempotente con CREATE IF NOT EXISTS)
# never:  deshabilitar en producción si el schema ya existe
SQL_INIT_MODE=always

# ─── Logging ──────────────────────────────────────────────
# Niveles: TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL_APP=INFO
